# X3DP 個人設定のテンプレート
#
#   1. このファイルを同じ場所に `.env` としてコピーする
#   2. 自分の値を書く(コメントを外す)
#
# `.env` は .gitignore 済みで、リポジトリには入りません。
# 環境変数が設定されていればそちらが優先されます。
# ここに書いた値は「アプリ内の初期値」になり、設定画面からいつでも変更できます。

# X3 の IP もしくはホスト名(Wi-Fi 接続のとき)
#X3_HOST=192.168.1.10
# Wi-Fi のポート
#X3_PORT=5283
# 既定の接続方式: ble (BLE ファーム向け) / wifi
#X3_TRANSPORT=ble
